# Bloat guard (2026-06-28): electron build binaries + caches that bloated .git
**/app-builder-bin*/
**/app-builder*
node_modules/
dist/
.cache/
target/
*.pack
.venv/
__pycache__/
.astro/

# Local Compose credentials and host overrides (never commit secrets).
.env.local
.env.*.local

# Release manifests are generated per build/commit and must be archived as CI
# artifacts, not committed from a developer worktree.
/release-manifest.json

# Runtime data directory (SQLite DBs, uploaded artifacts). Always local-only.
/data/
/data/*

# Node lockfiles + electron-builder output (not committed per repo convention)
package-lock.json
frontend/apps/desktop/release/
frontend/apps/desktop/build/icon.*
sidecar/go/tracera-sidecar

# Build caches (Turbo / Wrangler / Helios / Turbo logs)
.turbo/
frontend/.turbo/
**/.turbo/
frontend/.wrangler/
**/.wrangler/
frontend/.helios-harness/
**/.helios-harness/
frontend/runtime-performance-results.json
**/runtime-performance-results.json
frontend/**/.tsbuildinfo
**/*.tsbuildinfo
Tracera/worktrees/
**/worktrees/
frontend/packages/**/build/

.vercel
.env*.local
