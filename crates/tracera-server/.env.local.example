# =============================================================================
# Tracera local-only production stack — env template.
#
# This is the .env.local TEMPLATE (committed). Copy to .env.local (gitignored)
# and fill in. The defaults below are tuned to work with the docker-compose.dev.yml
# dev stack (Postgres on :5432, Neo4j on :7687, Upstash replaced by Redis on :6379).
#
# Architecture (Sep-2026): everything runs on this Windows device.  Public
# access via Cloudflare Tunnel (primary) or your Tailnet (preferred when
# off-LAN).  Canonical production URI:
#     tracera.pheno.studio/api  →  http://localhost:8080  (CF tunnel)
#     tracera.pheno.studio/api  →  http://100.x.y.z:8080  (Tailnet IP of host)
#     mcp.tracera.pheno.studio   →  http://localhost:8081  (CF tunnel)
#
# All of these are OPTIONAL except DATABASE_URL (the server uses SQLite-in-memory
# as the no-DB fallback). Absent vars = feature silently no-ops.
# =============================================================================

# --- Core ---
DATABASE_URL=postgres://tracera:tracera_dev@localhost:5432/tracera
TRACERA_AUTH_TOKEN=tracera_local_dev_token_change_me
TRACERA_BIND_ADDR=0.0.0.0:8080
TRACERA_PUBLIC_BIND_MODE=authenticated-proxy
RUST_LOG=info,tracera_server=debug

# --- Public URL (canonical: tracera.pheno.studio) ---
# This is what the server uses in CORS + Location headers + WorkOS redirect URLs.
TRACERA_PUBLIC_URL=https://tracera.pheno.studio
TRACERA_API_BASE=https://tracera.pheno.studio/api

# --- Cloudflare Tunnel ---
# Filled in by `cloudflared login` + `cloudflared tunnel create tracera`.
# Copy `~/.cloudflared/cert.pem` next to this file before running the tunnel.
TRACERA_TUNNEL_TOKEN=

# --- Upstash / Redis cache (optional) ---
# Local Redis from compose: redis://tracera_dev:tracera_dev@localhost:6379
# Upstash: https://xxx.upstash.io + token in the second segment
CACHE_URL=
CACHE_TOKEN=

# --- Neo4j Aura / local Neo4j from compose (optional) ---
# Local: bolt://localhost:7687 with compose creds neo4j/neo4j_dev_password
# Aura: neo4j+s://xxx.databases.neo4j.io
NEO4J_URL=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Cloudflare R2 / S3-compatible (optional) ---
# Local MinIO from compose: http://localhost:9000
# R2: https://xxx.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tracera-artifacts
