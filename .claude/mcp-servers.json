{
  "mcpServers": {
    "tracertm-stdio": {
      "command": "tracertm-mcp",
      "disabled": false,
      "alwaysAllow": [
        "project_manage",
        "item_manage",
        "link_manage",
        "trace_analyze",
        "graph_analyze",
        "quality_analyze",
        "config_manage",
        "sync_manage",
        "get_health"
      ]
    },
    "tracertm-http": {
      "transport": "http",
      "url": "http://localhost:4000/mcp",
      "disabled": false,
      "headers": {
        "Authorization": "Bearer ${TRACERTM_MCP_HTTP_TOKEN}"
      },
      "alwaysAllow": [
        "project_manage",
        "item_manage",
        "link_manage",
        "trace_analyze",
        "graph_analyze",
        "quality_analyze",
        "config_manage",
        "sync_manage",
        "get_health"
      ]
    }
  }
}
