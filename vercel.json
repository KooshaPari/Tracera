{
  "version": 2,
  "name": "tracera",
  "buildCommand": "cd frontend && bun install && bun run build:web",
  "outputDirectory": "frontend/apps/web/dist",
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}