FROM rust:1.94-bookworm AS build

WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN cargo build --locked --release -p tracera-server

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/target/release/tracera-server /usr/local/bin/tracera-server

ENV TRACERA_BIND_ADDR=0.0.0.0:8080
EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=12 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/tracera-server"]
