    <iconUrl>https://raw.githubusercontent.com/KooshaPari/Tracera/main/packaging/icons/tracera-icon.png</iconUrl>
    <docsUrl>https://github.com/KooshaPari/Tracera/blob/main/README.md</docsUrl>
