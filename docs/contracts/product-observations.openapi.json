{
  "openapi": "3.0.3",
  "info": {
    "title": "Tracera durable product observations",
    "version": "1.0.0",
    "description": "One product and immutable baseline per atomic batch. Canonical identity ordering; exact replay is idempotent. Authentication and CSRF follow the mounted server middleware."
  },
  "paths": {
    "/api/v1/products/{product}/baselines/{baseline}/observations": {
      "parameters": [
        {
          "name": "product",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        {
          "name": "baseline",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      ],
      "get": {
        "operationId": "readProductObservations",
        "responses": {
          "200": {
            "description": "Persisted typed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductObservationModel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path baseline"
          },
          "401": {
            "description": "Bearer authentication required when configured"
          },
          "403": {
            "description": "Mutation missing valid CSRF origin/token"
          },
          "404": {
            "description": "Product baseline absent"
          },
          "409": {
            "description": "Immutable evidence/replay conflict or capacity reached"
          },
          "413": {
            "description": "Request body exceeds 10 MiB"
          },
          "422": {
            "description": "Invalid batch or path/body scope mismatch"
          },
          "503": {
            "description": "Store unavailable or query timeout"
          }
        }
      },
      "post": {
        "operationId": "ingestProductObservations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductObservationBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted typed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductIngestReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path baseline"
          },
          "401": {
            "description": "Bearer authentication required when configured"
          },
          "403": {
            "description": "Mutation missing valid CSRF origin/token"
          },
          "404": {
            "description": "Product baseline absent"
          },
          "409": {
            "description": "Immutable evidence/replay conflict or capacity reached"
          },
          "413": {
            "description": "Request body exceeds 10 MiB"
          },
          "422": {
            "description": "Invalid batch or path/body scope mismatch"
          },
          "503": {
            "description": "Store unavailable or query timeout"
          }
        }
      }
    },
    "/api/v1/products/{product}/baselines/{baseline}/findings": {
      "parameters": [
        {
          "name": "product",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        {
          "name": "baseline",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      ],
      "get": {
        "operationId": "detectProductFindings",
        "responses": {
          "200": {
            "description": "DetectorResult from product::detectors, version 1.1.0",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectorResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path baseline"
          },
          "401": {
            "description": "Bearer authentication required when configured"
          },
          "403": {
            "description": "Mutation missing valid CSRF origin/token"
          },
          "404": {
            "description": "Product baseline absent"
          },
          "409": {
            "description": "Immutable evidence/replay conflict or capacity reached"
          },
          "413": {
            "description": "Request body exceeds 10 MiB"
          },
          "422": {
            "description": "Invalid batch or path/body scope mismatch"
          },
          "503": {
            "description": "Store unavailable or query timeout"
          }
        }
      }
    },
    "/api/v1/products/{product}/baselines/{baseline}/benchmark-observations": {
      "parameters": [
        {
          "name": "product",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        {
          "name": "baseline",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      ],
      "post": {
        "operationId": "ingestBenchmarkObservation",
        "description": "Reuses existing benchmark envelope validation. Causality is asserted source metadata; it does not prove authenticated producer or tenant ownership. Recorded time must be retained on retry. Status passed=>Passed, failed/timeout=>Failed, cancelled=>Unknown. Complete canonical envelope hash is immutable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BenchmarkObservationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted typed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductIngestReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path baseline"
          },
          "401": {
            "description": "Bearer authentication required when configured"
          },
          "403": {
            "description": "Mutation missing valid CSRF origin/token"
          },
          "404": {
            "description": "Product baseline absent"
          },
          "409": {
            "description": "Immutable evidence/replay conflict or capacity reached"
          },
          "413": {
            "description": "Request body exceeds 10 MiB"
          },
          "422": {
            "description": "Invalid batch or path/body scope mismatch"
          },
          "503": {
            "description": "Store unavailable or query timeout"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ObservationSource": {
        "type": "object",
        "properties": {
          "collector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifact_ref": {
            "type": "string",
            "nullable": true
          },
          "causality": {
            "$ref": "#/components/schemas/BenchmarkCausality"
          }
        },
        "required": [
          "collector",
          "version"
        ]
      },
      "AcceptedIntent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "enum": [
              "Requirement",
              "Obligation",
              "Capability",
              "Target"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Accepted",
              "Deferred",
              "Retired"
            ]
          },
          "baseline": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "description",
          "status",
          "baseline"
        ]
      },
      "Observation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "baseline": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "kind": {
            "type": "string",
            "enum": [
              "TestResult",
              "Measurement",
              "Finding",
              "Assessment"
            ]
          },
          "result": {
            "type": "string",
            "enum": [
              "Passed",
              "Failed",
              "Stale",
              "Unknown",
              "Inconclusive"
            ]
          },
          "source": {
            "$ref": "#/components/schemas/ObservationSource"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "capability_id": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "product_id",
          "baseline",
          "kind",
          "result",
          "source",
          "recorded_at"
        ]
      },
      "ProductObservationModel": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "baseline": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "intents": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/AcceptedIntent"
            }
          },
          "observations": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          }
        },
        "required": [
          "product_id",
          "baseline",
          "intents",
          "observations"
        ]
      },
      "ProductObservationBatch": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "baseline": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "intents": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/AcceptedIntent"
            }
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "product_id",
          "baseline",
          "intents",
          "observations",
          "idempotency_key"
        ]
      },
      "ProductIngestReceipt": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "minimum": 0
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "accepted",
          "replayed"
        ]
      },
      "DetectorFinding": {
        "type": "object",
        "required": [
          "kind",
          "product_id",
          "capability_id",
          "message",
          "evidence",
          "detector_version",
          "detected_at",
          "severity"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Freshness",
              "Coverage",
              "Contradiction"
            ]
          },
          "product_id": {
            "type": "string"
          },
          "capability_id": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detector_version": {
            "type": "string"
          },
          "detected_at": {
            "type": "string",
            "format": "date-time"
          },
          "severity": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical",
              "Info"
            ]
          }
        }
      },
      "DetectorResult": {
        "type": "object",
        "required": [
          "findings",
          "products_scanned",
          "capabilities_scanned",
          "detector_version",
          "ran_at"
        ],
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetectorFinding"
            }
          },
          "products_scanned": {
            "type": "integer"
          },
          "capabilities_scanned": {
            "type": "integer"
          },
          "detector_version": {
            "type": "string"
          },
          "ran_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BenchmarkCausality": {
        "type": "object",
        "required": [
          "tenant_id",
          "run_id",
          "session_id",
          "attempt_id",
          "replay_hash",
          "envelope_sha256"
        ],
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string",
            "pattern": "^run_[a-fA-F0-9]{64}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^ses_[a-fA-F0-9]{64}$"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^att_[a-fA-F0-9]{64}$"
          },
          "replay_hash": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "envelope_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "BenchmarkEnvelope": {
        "type": "object",
        "required": [
          "schema_version",
          "tenant_id",
          "run_id",
          "session_id",
          "attempt_id",
          "result"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^run_[a-fA-F0-9]{64}$"
          },
          "session_id": {
            "type": "string",
            "pattern": "^ses_[a-fA-F0-9]{64}$"
          },
          "attempt_id": {
            "type": "string",
            "pattern": "^att_[a-fA-F0-9]{64}$"
          },
          "result": {
            "type": "object",
            "required": [
              "status",
              "replay_hash"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "timeout",
                  "cancelled"
                ]
              },
              "replay_hash": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      },
      "BenchmarkObservationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "baseline",
          "capability_id",
          "intents",
          "recorded_at",
          "envelope"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "baseline": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "intents": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/AcceptedIntent"
            }
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "envelope": {
            "$ref": "#/components/schemas/BenchmarkEnvelope"
          }
        }
      }
    }
  }
}
