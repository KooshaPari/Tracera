{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline",
    "coverage",
    "missing_ids",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "baseline": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "coverage": {
      "const": "partial_supplied_excerpt"
    },
    "missing_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^T-[0-9]{2}$"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "horizon",
          "source",
          "evidence",
          "proposed_acceptance",
          "existing_requirement_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "horizon": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "proposed_acceptance": {
            "type": "string",
            "minLength": 1
          },
          "existing_requirement_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
