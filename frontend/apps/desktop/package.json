{
  "name": "tracera-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Tracera desktop app — Electrobun shell loading the Tracera web UI with system tray support.",
  "author": {
    "name": "Phenotype",
    "email": "kooshapari@gmail.com"
  },
  "scripts": {
    "dev": "bunx electrobun dev",
    "build": "bunx electrobun build",
    "build:release": "bunx electrobun build --env=production",
    "package": "bunx electrobun package",
    "test:e2e": "bun test tests/e2e_desktop.test.ts --timeout 60000",
    "postinstall": "bun scripts/postinstall.ts",
    "postbuild": "bun scripts/prepare-bundle.ts",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:all": "electron-builder -mwl"
  },
  "dependencies": {
    "electrobun": "^1.18.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "electron-builder": "^25.1.8"
  }
}
