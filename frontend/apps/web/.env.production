# Production environment (Vercel) — Vercel-hosted frontend talking to
# same-origin Vercel Functions.
#
# Reconciled production topology (2026-10-13):
#
#   Web/Auth:       https://tracera.pheno.studio        (Cloudflare Access)
#   Direct backend: https://t.tracera.pheno.studio      (Cloudflare Access)
#   Edge Worker:    https://tracera-edge.pheno.studio
#
# api.tracera.pheno.studio and mcp.tracera.pheno.studio are not live DNS
# endpoints in this reconciliation.
#
# For the Vercel-hosted frontend, /api routes to same-origin Vercel
# Functions (41 routes served by a single catch-all `api/[...path].ts`,
# consolidated to fit Vercel's Hobby-plan 12-function cap). When the
# If Vercel Functions later proxy to the direct backend, use
# TRACERA_BACKEND_URL=https://t.tracera.pheno.studio and provide the
# corresponding Access machine-credential headers in the server-side proxy.
# Browser code must not embed Cloudflare service-token secrets.
#
# Local dev override: place a .env.local sibling to this file
# (gitignored) with VITE_API_URL=http://localhost:8080 and the
# Vite dev server will pick it up.
VITE_API_URL=/api
VITE_WS_URL=/api/ws
VITE_ENABLE_GRAPH_VIEW=true
VITE_ENABLE_REALTIME_SYNC=true
VITE_ENABLE_AI_SUGGESTIONS=false
VITE_ENABLE_EXPORT=true
VITE_ENABLE_IMPORT=true
VITE_ENABLE_COLLABORATION=false
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_ANALYTICS_PROVIDER=none
VITE_LOG_LEVEL=info
VITE_SOURCEMAPS=false
