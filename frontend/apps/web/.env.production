# Production environment (Vercel) — canonical Tracera URIs
#
# Architectural rule (Sep-2026): all Tracera production URIs map to
# tracera.pheno.studio.  The full URI space:
#
#   Public API:   https://tracera.pheno.studio/api/*
#   Alt API:      https://api.tracera.pheno.studio
#   MCP:          https://mcp.tracera.pheno.studio
#   Edge Worker:  https://tracera-edge.pheno.studio
#
# These resolve to the local Tracera backend via the Cloudflare
# Tunnel (preferred), with the Render fallback for redundancy. The
# Render URLs are kept only as a temp fallback comment below.
#
# Local dev override: place a .env.local sibling to this file
# (gitignored) with VITE_API_URL=http://localhost:8080 and the
# Vite dev server will pick it up.

VITE_API_URL=https://tracera.pheno.studio/api
VITE_WS_URL=wss://tracera.pheno.studio/ws

# Optional override: the public Render fallback (image-deploy from GHCR)
# VITE_FALLBACK_URL=https://tracera-server.onrender.com
