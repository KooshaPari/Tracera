# Paths oxfmt must not rewrite.
#
# Mirrors the `ignorePatterns` block in .oxlintrc.json (so lint and format agree
# on what is generated) and adds the build / cache output that is never
# hand-edited. `package.json`'s `format:check` script passes this path
# explicitly with --ignore-path, so the file must exist for the gate to run.

# Vendored dependencies and build output.
**/node_modules/**
**/dist/**
**/build/**
**/.turbo/**
**/.next/**
**/.wrangler/**
**/coverage/**
**/storybook-static/**

# Generated sources: re-emitted by codegen, so formatting them here would be
# undone the next time the generator runs.
**/routeTree.gen.ts
**/api/*.gen.ts
**/*.generated.*
**/public/mockServiceWorker.js

# Lockfiles and package-manager output.
bun.lock
package-lock.json

# Prettier and oxfmt 0.27 disagree on these files. The Lint & Format workflow
# checks changed Markdown and JSON with prettier, so prettier owns them.
apps/web/public/specs/openapi.json
apps/web/visual/README.md
packages/env-manager/README.md
turbo.json
.oxlintrc.json
packages/ui/src/__tests__/Card.test.tsx
packages/ui/src/__tests__/Alert.test.tsx
apps/web/src/__tests__/api/events.test.ts
apps/web/src/__tests__/api/reports.test.ts
apps/web/src/__tests__/components/layout/Header.test.tsx
apps/web/src/__tests__/integration/app-integration.test.tsx
apps/web/src/__tests__/pages/ProjectsList.test.tsx
apps/web/src/__tests__/equivalenceIO.test.ts
apps/web/src/components/forms/CreateItemDialog.test.tsx
apps/web/src/__tests__/components/CreateItemDialog.error-handling.test.tsx
apps/web/src/__tests__/components/CreateLinkForm.test.tsx
apps/web/src/__tests__/components/CreateItemForm.test.tsx
apps/web/src/__tests__/components/CreateProjectForm.test.tsx
apps/web/src/__tests__/components/CreateTestItemForm.test.tsx
apps/web/src/__tests__/lib/validation.test.ts
apps/web/src/__tests__/utils/helpers.comprehensive.test.ts
apps/web/src/__tests__/workers/integration.test.ts
apps/web/src/__tests__/security/input-validation.test.tsx
