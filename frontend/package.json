{
  "name": "tracera-frontend",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build --prefix apps/web",
    "build:full": "npm run build --prefix apps/web",
    "dev": "npm run dev --prefix apps/web",
    "desktop": "npm run start --prefix apps/desktop",
    "desktop:dev": "npm run start:dev --prefix apps/desktop",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "app-builder-bin": "4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.3"
  }
}
