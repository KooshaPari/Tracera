+
+    async def _startup_initialization(*_: Any, **__: Any) -> None:
+        return None
+
+    startup_module.startup_initialization = _startup_initialization  # type: ignore[attr-defined]
+    sys.modules["tracertm.api.config.startup"] = startup_module
+
