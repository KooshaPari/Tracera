+            link = Link(
+                project_id=request.project_id,
+                graph_id=graph_id,
+                source_id=request.source_id,
+                target_id=request.target_id,
+                type=request.type,
+                metadata=request.metadata or {},
+            )
+            db.add(link)
+            await db.commit()
