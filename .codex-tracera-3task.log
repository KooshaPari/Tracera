+ASGITransport. It keeps the backend self-contained by overriding only the
+database, auth, and cache dependencies that would otherwise require external
+services.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+import types
+from collections.abc import AsyncGenerator
+from pathlib import Path
+from typing import Any
+from uuid import uuid4
+
+import pytest
+import pytest_asyncio
+from httpx import ASGITransport, AsyncClient
+
+pytestmark = [pytest.mark.integration, pytest.mark.slow]
+
+
+def _repo_root() -> Path:
+    return Path(__file__).resolve().parents[2]
+
+
+def _src_root() -> Path:
+    return _repo_root() / "src"
+
+
+def _install_namespace_stubs() -> None:
+    tracertm_root = _src_root() / "tracertm"
+    for package_dir in [tracertm_root, *[path for path in tracertm_root.rglob("*") if path.is_dir()]]:
+        init_file = package_dir / "__init__.py"
+        if not init_file.exists():
+            continue
+        package_name = "tracertm" if package_dir == tracertm_root else "tracertm." + ".".join(
+            package_dir.relative_to(tracertm_root).parts
+        )
+        module = sys.modules.get(package_name)
+        if module is None:
+            module = types.ModuleType(package_name)
+            sys.modules[package_name] = module
+        module.__path__ = [str(package_dir)]  # type: ignore[attr-defined]
+
+
+def _load_module(module_name: str, module_path: Path) -> types.ModuleType:
+    spec = importlib.util.spec_from_file_location(module_name, module_path)
+    if spec is None or spec.loader is None:
+        msg = f"Unable to load {module_name} from {module_path}"
+        raise RuntimeError(msg)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def _install_test_modules() -> None:
+    deps_module = types.ModuleType("tracertm.api.deps")
+
+    async def _get_db() -> AsyncGenerator[Any, None]:
+        yield None
+
+    def _get_cache_service() -> Any:
+        return None
+
+    async def _get_event_bus() -> Any:
+        return None
+
+    def _auth_guard(*_: Any, **__: Any) -> dict[str, Any]:
+        return {"sub": "stub-user"}
+
+    deps_module.get_db = _get_db  # type: ignore[attr-defined]
+    deps_module.get_cache_service = _get_cache_service  # type: ignore[attr-defined]
+    deps_module.get_event_bus = _get_event_bus  # type: ignore[attr-defined]
+    deps_module.auth_guard = _auth_guard  # type: ignore[attr-defined]
+    deps_module.verify_token = lambda *_: {"sub": "stub-user"}  # type: ignore[attr-defined]
+    sys.modules["tracertm.api.deps"] = deps_module
+
+    security_module = types.ModuleType("tracertm.api.security")
+    security_module.ensure_credential_access = lambda *_, **__: None  # type: ignore[attr-defined]
+    security_module.ensure_project_access = lambda *_, **__: None  # type: ignore[attr-defined]
+    security_module.ensure_write_permission = lambda *_, **__: None  # type: ignore[attr-defined]
+    sys.modules["tracertm.api.security"] = security_module
+
+    rate_limiting_module = types.ModuleType("tracertm.api.config.rate_limiting")
+    rate_limiting_module.enforce_rate_limit = lambda *_, **__: None  # type: ignore[attr-defined]
