+            await cache_service.invalidate_project(request.project_id)
+            return {
+                "id": str(link.id),
+                "source_id": str(link.source_item_id),
+                "target_id": str(link.target_item_id),
+                "type": link.link_type,
+                "metadata": getattr(link, "link_metadata", None) or {},
+            }
+
+        yield application
+
