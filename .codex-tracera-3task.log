+
+    async with async_session_factory() as async_db_session:
+        async def get_db() -> AsyncGenerator[Any, None]:
+            yield async_db_session
+
+        async def get_cache_service() -> _FakeCacheService:
+            return cache
+
+        def auth_guard() -> dict[str, Any]:
+            return {
